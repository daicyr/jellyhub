AUTH_SECRET= # secret for auth, generate with openssl rand -base64 32
APP_URL= # app url
APP_PORT=3000 # host port used by Docker Compose
SECRET_KEY= # secret for server tokens, generate with openssl rand -base64 32
ALLOW_SIGNUP= # allow users to sign up, set to true or false
DATABASE_URL=postgresql://jellyhub:jellyhub@localhost:5432/jellyhub
POSTGRES_USER=jellyhub
POSTGRES_PASSWORD=jellyhub
POSTGRES_DB=jellyhub
